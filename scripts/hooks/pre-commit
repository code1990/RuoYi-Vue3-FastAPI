#!/usr/bin/env bash
set -euo pipefail

readonly blocked_pattern='^(ruoyi-fastapi-app|ruoyi-fastapi-test)/'
blocked_files=$(git diff --cached --name-only --diff-filter=ACMRD | grep -E "$blocked_pattern" || true)

if [[ -z "$blocked_files" ]]; then
  exit 0
fi

echo '服务端工作副本不能提交移动端或测试目录：' >&2
echo "$blocked_files" >&2
echo '请在 Windows 前端工作副本提交；紧急情况使用 git commit --no-verify。' >&2
exit 1
